# =============================================================================
# Storefront environment variables (copy to .env for local dev)
# =============================================================================
# Local dev values for the Medusa integration. Copy this file to `.env` and
# fill in the publishable key. `.env` is git-ignored; never commit real keys.

# ── Local dev (browser + dev SSR) ─────────────────────────────────────────────
# VITE_* values are baked into the browser bundle at build time by Vite.

# Medusa backend base URL. Defaults to http://localhost:9000 when unset.
VITE_MEDUSA_BACKEND_URL=http://localhost:9000

# Storefront publishable API key (scoped to the India sales channel).
# This is PUBLIC client-side config, not a backend secret.
VITE_MEDUSA_PUBLISHABLE_KEY=

# Razorpay public key id (client-side, NEVER the secret; the secret stays on the
# backend). Needed to open the Razorpay checkout modal. From the Razorpay
# dashboard (test or live keys). Empty = checkout shows "not configured".
VITE_RAZORPAY_KEY_ID=

# ── Production (Cloudflare Workers SSR + client build) ───────────────────────
# The browser bundle can ONLY see values baked in at BUILD time (VITE_*), so the
# production client build environment must set the VITE_* trio above to the live
# values: VITE_MEDUSA_BACKEND_URL=https://api.yourdailydrip.com, the live
# publishable key, and the live Razorpay key id.
#
# The Worker's SSR runtime instead reads MEDUSA_BACKEND_URL / MEDUSA_PUBLISHABLE_KEY
# from the Worker env at RUNTIME. Set them once as Workers secrets:
#   npx wrangler secret put MEDUSA_BACKEND_URL       # e.g. https://api.yourdailydrip.com
#   npx wrangler secret put MEDUSA_PUBLISHABLE_KEY   # pk_...
#   npx wrangler secret put RAZORPAY_KEY_ID          # rzp_live_...
# (or run ./scripts/setup-secrets.sh / .\scripts\setup-secrets.ps1)
#
# These are PUBLIC config. Backend-only secrets — RAZORPAY_SECRET,
# RAZORPAY_WEBHOOK_SECRET, DATABASE_URL, JWT_SECRET, COOKIE_SECRET, ITHINK_* —
# stay on the Medusa VPS and are never storefront vars, secrets, or docs.
