# CORS origins. Local dev only: storefront on 5173, admin on 9000.
# Deploy wave (todo 16) adds the Cloudflare preview origin and https://yourdailydrip.com.
# NEVER use a wildcard "*" with credentials.
STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:5173
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Razorpay payment provider (todo 9 - medusa-plugin-razorpay-v2 0.1.4).
# REQUIRED for the backend to boot with the provider enabled: generate test keys
# from the Razorpay dashboard (Settings > API Keys) and the webhook secret from
# Settings > Webhooks. The provider init throws "razorpay not configured" while
# empty. Never expose RAZORPAY_SECRET / RAZORPAY_WEBHOOK_SECRET to the storefront.
RAZORPAY_ID=
RAZORPAY_SECRET=
RAZORPAY_ACCOUNT=
RAZORPAY_WEBHOOK_SECRET=

# iThink Logistics V3 fulfillment provider (todo 11 - src/modules/ithink).
# BASE_URL must include the /api_v3 segment, e.g. https://pre-alpha.ithinklogistics.com/api_v3
# for staging. ACCESS_TOKEN and SECRET_KEY are sent inside the request body JSON (never
# headers). PICKUP_ADDRESS_ID is the pickup address registered in the iThink dashboard.
# The provider boots without these; checkout then surfaces readable iThink errors.
ITHINK_BASE_URL=
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
ITHINK_PICKUP_ADDRESS_ID=
ITHINK_GST_NUMBER=

