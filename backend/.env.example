# ---------------------------------------------------------------------------
# Daily Drip Medusa backend - environment matrix (DEV vs PROD).
#
# DEV:  copy this file to apps/backend/.env (local development).
# PROD: copy this file to backend/.env on the VPS and set real values -
#       `docker compose -f docker-compose.prod.yml` reads it automatically.
#
# NEVER commit or paste real secret values. Every value below is a
# placeholder. Generate secrets on the VPS with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- CORS -------------------------------------------------------------------
# Comma-separated origins, NO spaces, NEVER a wildcard "*" with credentials.
# Store/auth origins: the storefront domains that may call the Store API.
# Admin origin: the domain the admin dashboard is served from.
#   DEV:  storefront on http://localhost:5173, admin on http://localhost:9000
#   PROD: storefront https://yourdailydrip.com (+ Cloudflare preview origin,
#         e.g. https://<preview-subdomain>.workers.dev - update after each
#         preview deploy), admin https://api.yourdailydrip.com
STORE_CORS=http://localhost:5173
AUTH_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:9000
# PROD STORE_CORS example (uncomment and edit when deploying):
# STORE_CORS=https://yourdailydrip.com,https://<preview-subdomain>.workers.dev,http://localhost:5173
# PROD AUTH_CORS example:
# AUTH_CORS=https://yourdailydrip.com,https://<preview-subdomain>.workers.dev,http://localhost:5173
# PROD ADMIN_CORS example:
# ADMIN_CORS=https://api.yourdailydrip.com,http://localhost:9000

# --- Database ---------------------------------------------------------------
# DEV:  local Docker Postgres on host port 5433 (Windows PostgreSQL owns 5432)
# PROD: compose builds the URL from POSTGRES_* below and points at the
#       `postgres` service (postgres://medusa:<pass>@postgres:5432/medusa).
#       Do NOT set a localhost DATABASE_URL in PROD.
DATABASE_URL=postgres://postgres@localhost:5433/medusa-backend

# --- Auth secrets (REQUIRED in PROD) ----------------------------------------
# DEV:  any string is fine. PROD: `openssl rand -base64 32` for each.
JWT_SECRET=dev-only-supersecret
COOKIE_SECRET=dev-only-supersecret

# --- Redis (optional) -------------------------------------------------------
# Medusa runs with an in-memory cache fallback when this is empty (build emits
# a warning). Set a managed Redis if you want cross-restart caching.
REDIS_URL=

# --- Razorpay (REQUIRED in PROD - provider will NOT boot without these) -----
# Get test keys from the Razorpay dashboard (Settings > API Keys), the
# webhook secret from Settings > Webhooks (create one for the URL below),
# and the account number from Settings > Account Details.
# RAZORPAY_SECRET / RAZORPAY_WEBHOOK_SECRET are backend-only secrets - never
# expose them to the storefront.
RAZORPAY_ID=paste_razorpay_key_id
RAZORPAY_SECRET=paste_razorpay_key_secret
RAZORPAY_ACCOUNT=paste_razorpay_account_number
RAZORPAY_WEBHOOK_SECRET=paste_razorpay_webhook_secret

# --- iThink Logistics (staging for now) --------------------------------------
# Staging credentials come from the iThink team; warehouse approval (~24h) is
# needed before live rate/shipment testing. BASE_URL must include /api_v3.
# Access token + secret key are sent inside the request body JSON (never
# headers). PICKUP_ADDRESS_ID is the approved pickup address in the iThink
# dashboard.
ITHINK_BASE_URL=https://pre-alpha.ithinklogistics.com/api_v3
ITHINK_ACCESS_TOKEN=paste_ithink_access_token
ITHINK_SECRET_KEY=paste_ithink_secret_key
ITHINK_PICKUP_ADDRESS_ID=paste_ithink_pickup_address_id

# --- Cloudflare R2 file storage (product image uploads) ----------------------
# S3-compatible storage powering admin-dashboard product image uploads
# (POST /admin/uploads). All S3_* vars below are REQUIRED in PROD - the
# file-s3 provider throws at boot without them (fail fast).
# Setup (Cloudflare dashboard, ~5 min):
#   1. R2 > Create bucket (e.g. yourdailydrip-media). Region: APAC.
#   2. R2 > Manage R2 API Tokens > Create API token with "Object Read & Write"
#      on that bucket -> copy Access Key ID + Secret Access Key.
#   3. Bucket > Settings > Custom Domains > add cdn.yourdailydrip.com (Cloudflare
#      auto-provisions the DNS record; production-grade public URL - r2.dev is
#      rate-limited and non-production, use it only as a temporary fallback).
# S3_ENDPOINT is the R2 S3 endpoint: https://<account_id>.r2.cloudflarestorage.com
# (Account ID is in the Cloudflare dashboard sidebar / Workers & Pages).
# S3_REGION must be "auto" (R2 ignores it). S3_PREFIX optionally scopes uploads
# (e.g. "products/"). S3_FILE_URL is the public base URL WITHOUT a trailing
# slash: https://cdn.yourdailydrip.com for a custom domain, or
# https://pub-<hash>.r2.dev/<bucket-name> for the r2.dev subdomain.
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are backend-only secrets - never
# expose them to the storefront.
S3_ENDPOINT=https://0b28101faacfe7616f537657d23903f0.r2.cloudflarestorage.com
S3_BUCKET=yourdailydrip-media
S3_REGION=auto
S3_PREFIX=
S3_ACCESS_KEY_ID=paste_r2_access_key_id
S3_SECRET_ACCESS_KEY=paste_r2_secret_access_key
S3_FILE_URL=https://cdn.yourdailydrip.com

# --- Compose-only (PROD) ------------------------------------------------------
# Used by docker-compose.prod.yml to create the Postgres container and to
# build DATABASE_URL. CADDY_EMAIL receives Let's Encrypt expiry notices.
POSTGRES_USER=medusa
POSTGRES_DB=medusa
POSTGRES_PASSWORD=paste_a_strong_postgres_password
CADDY_EMAIL=you@yourdailydrip.com
